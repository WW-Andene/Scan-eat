<?xml version="1.0" encoding="utf-8"?>
<!--
    Sized for a compact 3x1 home-screen cell - just a last-scan summary line
    and one button, doesn't need TodayWidget's taller multi-row layout.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="90dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/scan_widget_loading"
    android:previewImage="@mipmap/ic_launcher"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_scan_description" />
