<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+): the app keeps diary, health, medication and weight data strictly on
     device. allowBackup="false" already disables legacy backup; these rules make the same
     guarantee explicit for cloud backup AND device-to-device transfer. Users move data with the
     in-app (optionally passphrase-encrypted) backup export instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
