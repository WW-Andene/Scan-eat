<?xml version="1.0" encoding="utf-8"?>
<!--
  Server mode's realistic deployment is a self-hosted backend on the user's
  own LAN (a home server, a laptop running the companion server app, or the
  Android emulator's host-loopback address) - plain http:// is the normal
  case there. usesCleartextTraffic="false" in the manifest blocks this at
  the OS level regardless of any app-side URL validation (see
  ServerScanApiProvider.isPrivateOrLocalHttp), so this config carves out
  cleartext exceptions for exactly those private/local ranges while keeping
  the manifest-level block for every other (public internet) host.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <!--
          <domain-config> only accepts <domain> child elements - there is no
          <ip-address> element in this schema. A previous version put
          127.0.0.1 under its own <domain-config> using <ip-address>, which
          the platform's XmlConfigSource rejects at parse time with "No
          domain elements in domain-config" - since that domain-config had
          zero valid <domain> children, the whole config failed to parse and
          the Application crashed on every single launch (Unable to
          instantiate application - Failed to parse XML configuration from
          network_security_config). A literal IP string works fine as a
          <domain> element's text (Android matches it by exact string, same
          as a hostname), so 127.0.0.1 moves in here instead of using the
          nonexistent <ip-address> tag.
        -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">local</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
